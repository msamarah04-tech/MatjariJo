modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
NODE_ENV = "development"
JWT_SECRET = "dev-matjari-jwt-secret-change-in-production-32chars"
JWT_EXPIRES_IN = "30m"
JWT_REFRESH_EXPIRES_IN = "30d"
COOKIE_SECRET = "dev-cookie-secret-16chars"
PORT = "4000"
REQUEST_BODY_LIMIT = "50mb"
ALLOW_OWNER_REGISTRATION = "false"
INITIAL_PLATFORM_PASSWORD = "ChangeMe123!"
INITIAL_PLATFORM_NAME = "Platform Owner"

[userenv.shared]
INITIAL_PLATFORM_EMAIL = "msamarah.04@gmail.com"
INITIAL_PLATFORM_USERNAME = "adminplatform"
MAIL_FROM = "Matjari Jordan <no-reply@matjarijo.store>"
PUBLIC_BASE_DOMAIN = "matjarijo.com"
VITE_PUBLIC_BASE_DOMAIN = "matjarijo.com"

[userenv.production]
NODE_ENV = "production"
PORT = "5000"
FRONTEND_ORIGIN = "https://matjarijo.replit.app"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx concurrently -n frontend,backend -c cyan,magenta \"npm run dev\" \"npm run api:dev\""
waitForPort = 5000

[[ports]]
localPort = 4000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[deployment]
deploymentTarget = "vm"
run = ["npx", "tsx", "server/index.ts"]
build = ["bash", "-c", "npx prisma generate && npm run build"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
