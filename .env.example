# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Backend API
# NODE_ENV=production enables fail-closed checks: the server refuses to boot with a
# default/weak JWT_SECRET, the unchanged seed password, a missing COOKIE_SECRET, or a
# localhost FRONTEND_ORIGIN.
NODE_ENV="development"
DATABASE_URL="file:./dev.db"
# Use a random 32+ character secret in production.
JWT_SECRET="replace-with-at-least-32-random-characters-please"
# Short-lived access tokens; sessions stay alive via the refresh-token cookie.
JWT_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="30d"
# Required in production to sign the httpOnly refresh cookie (16+ chars).
COOKIE_SECRET="replace-with-a-random-cookie-secret"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
REQUEST_BODY_LIMIT="50mb"
ALLOW_OWNER_REGISTRATION="false"

# Multi-tenant storefront domains. With PUBLIC_BASE_DOMAIN="matjari.jo" every
# store is served from its own subdomain (borz.matjari.jo). Requires wildcard
# DNS (*.matjari.jo) and a wildcard TLS certificate pointing at this app.
# VITE_PUBLIC_BASE_DOMAIN is the same value, read by the frontend build.
# Leave both empty in development — <slug>.localhost works automatically.
PUBLIC_BASE_DOMAIN=""
VITE_PUBLIC_BASE_DOMAIN=""

# Outbound email (order confirmations, owner alerts, approvals, payment receipts).
# Resend takes precedence when set; otherwise SMTP; with neither configured sends
# are logged and skipped, so development works without any mail setup.
MAIL_FROM="Matjari Jordan <no-reply@matjari.jo>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Server-side error tracking (Sentry). Disabled when empty.
SENTRY_DSN=""

# Used by `npm run db:seed`; no demo stores/products/orders are seeded.
INITIAL_PLATFORM_EMAIL="owner@matjari.local"
INITIAL_PLATFORM_USERNAME="platform-admin"
INITIAL_PLATFORM_PASSWORD="ChangeMe123!"
INITIAL_PLATFORM_NAME="Platform Owner"
